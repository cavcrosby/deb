#!/bin/bash
#
# Builds the packages of the named source.

set -eo pipefail

. "./scripts/util.bash"

# constants
export CACHE_DIR_PATH="./.cache/betterleaks"

if ! [ "$(command -v git)" ]; then
    printf "%s: %s\n" "${PROGNAME}" "git cannot be found in the PATH!" >&2
    exit 1
fi

if [ "${VERSION}" ]; then
    tags="${VERSION}"
else
    tags="$(\
        git ls-remote \
            --refs \
            --tags \
            "https://github.com/betterleaks/betterleaks.git" \
            "v[[:digit:]]*\.[[:digit:]]*\.[[:digit:]]*" \
            | awk '{ sub("refs/tags/", "", $2); print $2 }' \
            | grep \
                --invert-match \
                --extended-regexp \
                "v[[:digit:]]+\.[[:digit:]]+\.[[:digit:]]+-\w+" \
    )"
fi

checkout \
    "betterleaks" \
    "v1.8.1" \
    "https://github.com/betterleaks/betterleaks.git" \
    "${CACHE_DIR_PATH}"

create_container "betterleaks" "${CACHE_DIR_PATH}"
setup_container
exec_container \
    "apt-get" \
    "install" \
    "--assume-yes" \
    "--no-install-recommends" \
    "git"

for tag in ${tags}; do
    if [ "${VERSION}" ] || is_ge_version "${tag}" "v1.8.1"; then
        destdir="$(\
            checkout \
            "betterleaks" \
            "${tag}" \
            "https://github.com/betterleaks/betterleaks.git" \
            "${CACHE_DIR_PATH}" \
        )"

        exec_build_pkgs_container "${tag}" "${CACHE_DIR_PATH}"
    fi
done

remove_container

exit 0
